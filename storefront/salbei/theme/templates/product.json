{
  "sections": {
    "main": {
      "type": "gravuru-product",
      "blocks": {
        "title": {
          "type": "title"
        },
        "price": {
          "type": "price"
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "dropdown",
            "swatch_shape": "circle"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector"
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": false,
            "show_gift_card_recipient": true
          }
        },
        "gravuru_personalize": {
          "type": "gravuru_personalize",
          "settings": {}
        },
        "subtitle": {
          "type": "text",
          "settings": {
            "text": "{{ product.metafields.custom.untertitel.value }}",
            "text_style": "body"
          }
        }
      },
      "block_order": [
        "title",
        "subtitle",
        "price",
        "variant_picker",
        "quantity_selector",
        "gravuru_personalize",
        "buy_buttons"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_position": "left",
        "gallery_layout": "thumbnail_slider",
        "media_size": "medium",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "show",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 44,
        "padding_bottom": 44
      }
    },
    "details": {
      "type": "gravuru-product-details",
      "settings": {},
      "blocks": {
        "description": {
          "type": "detail",
          "settings": {
            "title": "Beschreibung",
            "source": "description"
          }
        },
        "material": {
          "type": "detail",
          "settings": {
            "title": "Material & Zusammensetzung",
            "source": "material"
          }
        },
        "mounting": {
          "type": "detail",
          "settings": {
            "title": "Montage",
            "source": "mounting"
          }
        },
        "safety": {
          "type": "detail",
          "settings": {
            "title": "Sicherheitshinweise",
            "source": "safety"
          }
        }
      },
      "block_order": [
        "description",
        "material",
        "mounting",
        "safety"
      ]
    },
    "recommendations": {
      "type": "related-products",
      "settings": {
        "heading": "Das passt dazu",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "columns_mobile": "2",
        "image_ratio": "square",
        "show_secondary_image": false,
        "show_vendor": false,
        "show_rating": false,
        "color_scheme": "scheme-1",
        "padding_top": 36,
        "padding_bottom": 56
      }
    }
  },
  "order": [
    "main",
    "details",
    "recommendations"
  ]
}
