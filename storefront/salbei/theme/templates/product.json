{
  "sections": {
    "main": {
      "type": "gravuru-product",
      "blocks": {
        "title": {
          "type": "title"
        },
        "price": {
          "type": "price"
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "dropdown",
            "swatch_shape": "circle"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector"
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": false,
            "show_gift_card_recipient": true
          }
        },
        "description": {
          "type": "description"
        },
        "gravuru_personalize": {
          "type": "gravuru_personalize",
          "settings": {}
        }
      },
      "block_order": [
        "title",
        "description",
        "price",
        "variant_picker",
        "quantity_selector",
        "gravuru_personalize",
        "buy_buttons"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_position": "left",
        "gallery_layout": "thumbnail_slider",
        "media_size": "medium",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "show",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 44,
        "padding_bottom": 44
      }
    }
  },
  "order": [
    "main"
  ]
}
