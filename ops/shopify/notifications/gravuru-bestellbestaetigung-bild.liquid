{% comment %}
  Diesen Baustein in der vorhandenen Bestellschleife vor jeder Artikelzeile als
  gv_order_preview erfassen. Bei leerem Ergebnis das bisherige Artikelbild
  verwenden. Den erfassten Inhalt unter der Artikeltabelle, innerhalb derselben
  Bestellposition, in voller Breite ausgeben. Keine zusätzliche Bestellschleife.
{% endcomment %}
{%- liquid
  assign gv_image = line.properties['_gravuru_bild']
  assign gv_root = 'https://app-2027.gravuru-designwerkstatt.de/gestaltung/'
  assign gv_prefix = gv_image | slice: 0, gv_root.size
  assign gv_extension = gv_image | slice: -4, 4
  assign gv_valid = false
  if line.properties['_gravuru_config'] != blank and gv_prefix == gv_root and gv_extension == '.png'
    assign gv_valid = true
  endif
-%}
{%- if gv_valid -%}
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;table-layout:fixed;border-collapse:collapse;">
    <tr>
      <td style="padding:12px 0 0;">
        <a href="{{ gv_image | escape }}" target="_blank" style="display:block;text-decoration:none;">
          <img src="{{ gv_image | escape }}" alt="Ihre Gestaltung: {{ line.title | escape }}"
               width="100%" style="display:block;width:100%;max-width:100%;height:auto;border:0;" />
        </a>
        <p style="margin:8px 0 0;font-size:14px;line-height:1.4;">Bitte prüfe die Schreibweise.</p>
      </td>
    </tr>
  </table>
{%- endif -%}
