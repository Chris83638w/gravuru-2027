{% doc %}
  Personal image from this cart line's saved revision. The theme owns prices, quantity and removal.
  @param {line_item} item - Shopify cart line (native R15 or legacy upload).
{% enddoc %}
{%- liquid
  assign gv_native = false
  assign gv_legacy = false
  if item.properties['_gravuru_config'] != blank and item.properties['_gravuru_rev'] != blank
    assign gv_native = true
  elsif item.properties['_Gravuru Vorgang'] != blank and item.properties['Bearbeitbarer Entwurf'] != blank
    assign gv_legacy = true
  endif
  assign gv_preview = item.properties['_Entwurf']
  if gv_legacy
    assign gv_preview = item.properties['Entwurf']
  endif
  assign gv_cdn = 'https://cdn.shopify.com/'
  assign gv_prefix = gv_preview | slice: 0, gv_cdn.size
  assign gv_relative = gv_preview | slice: 0, 9
  assign gv_valid = false
  if gv_prefix == gv_cdn or gv_relative == '/uploads/'
    assign gv_valid = true
  endif
  unless gv_valid
    assign gv_hosted = item.properties['_gravuru_checkout_image'] | split: '?' | first
    assign gv_hosted_root = 'https://cdn.shopify.com/s/files/1/'
    assign gv_hosted_prefix = gv_hosted | slice: 0, gv_hosted_root.size
    assign gv_name = gv_hosted | split: '/' | last
    assign gv_digest = gv_name | remove_first: 'gravuru-gestaltung-' | remove_last: '.png'
    assign gv_name_check = gv_digest | prepend: 'gravuru-gestaltung-' | append: '.png'
    if gv_native and gv_hosted_prefix == gv_hosted_root and gv_hosted contains '/files/gravuru-gestaltung-' and gv_digest.size == 64 and gv_name == gv_name_check
      assign gv_preview = gv_hosted
      assign gv_valid = true
    endif
  endunless
  assign gv_saved = item.properties['_gravuru_bild']
  assign gv_root = 'https://app-2027.gravuru-designwerkstatt.de/gestaltung/'
  assign gv_saved_prefix = gv_saved | slice: 0, gv_root.size
  assign gv_suffix = gv_saved | slice: -4, 4
  if gv_native and gv_saved_prefix == gv_root and gv_suffix == '.png'
    assign gv_preview = gv_saved
    assign gv_valid = true
  endif
  assign gv_thumb = item.properties['_gravuru_checkout_image']
  assign gv_files = 'https://cdn.shopify.com/s/files/1/0920/5550/3228/files/gravuru-gestaltung-'
  assign gv_thumb_prefix = gv_thumb | slice: 0, gv_files.size
  assign gv_width_query = ''
  if gv_native and gv_thumb == item.properties['_Entwurf'] and gv_thumb_prefix == gv_files
    if gv_thumb contains '?'
      assign gv_width_query = '&amp;width='
    else
      assign gv_width_query = '?width='
    endif
  endif
-%}
{%- if gv_native or gv_legacy -%}
  <gravuru-cart-preview class="gravuru-cart-personalization">
    {%- if gv_valid -%}
      <a href="{{ gv_preview | escape }}" target="_blank" rel="noopener" aria-label="Persönliche Vorschau vergrößern">
        <img src="{{ gv_preview | escape }}" alt="Persönliche Gestaltung für {{ item.product.title | escape }}"
             {% if gv_width_query != blank %}srcset="{{ gv_thumb | escape }}{{ gv_width_query }}160 1x, {{ gv_thumb | escape }}{{ gv_width_query }}320 2x, {{ gv_thumb | escape }}{{ gv_width_query }}480 3x"{% endif %}
             width="160" height="120">
      </a>
      <span role="status">Persönliche Vorschau wird geladen …</span>
    {%- else -%}
      <span role="status">Die persönliche Vorschau ist derzeit nicht verfügbar.</span>
    {%- endif -%}
  </gravuru-cart-preview>
  <script type="module" src="{{ 'gravuru-cart-preview.js' | asset_url }}"></script>
{%- endif -%}
{% stylesheet %}
  gravuru-cart-preview { display: block; width: 100%; }
  gravuru-cart-preview a { display: block; min-height: 44px; }
  gravuru-cart-preview img { display: block; width: 100%; height: auto; object-fit: contain; }
  gravuru-cart-preview [role=status] { font-size: .875rem; overflow-wrap: anywhere; }
  .cart-item:has(.gravuru-cart-personalization) .cart-item__product--info,
  .cart-item:has(.gravuru-cart-personalization) .cart-item__details { min-width: 0; flex-basis: 0; }
  .cart-item:has(.gravuru-cart-personalization) .cart-item__title,
  .cart-item:has(.gravuru-cart-personalization) .cart-item__options dd { min-width: 0; overflow-wrap: anywhere; }
  .cart-item:has(.gravuru-cart-personalization) .cart-item__options > div { flex-wrap: wrap; }
  @media (max-width: 767px) {
    table:has(.gravuru-cart-personalization) { table-layout: fixed; }
    .cart-item:has(.gravuru-cart-personalization) .grid { min-width: 0; }
  }
{% endstylesheet %}
