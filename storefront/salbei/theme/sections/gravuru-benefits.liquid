<section class="g-benefits g-shell" aria-label="{{ section.settings.heading | default: section.settings.accessibility_label | escape }}" style="--g-benefits-space: {{ section.settings.spacing }}px;">
  {% if section.settings.heading != blank %}<h2 class="g-benefits__heading">{{ section.settings.heading | escape }}</h2>{% endif %}
  <ul class="g-benefits__list" role="list">
    {% for block in section.blocks %}
      <li class="g-benefits__item" {{ block.shopify_attributes }}>
        {% if block.settings.title != blank %}<h3>{{ block.settings.title | escape }}</h3>{% endif %}
        {% if block.settings.text != blank %}<p>{{ block.settings.text | escape }}</p>{% endif %}
      </li>
    {% endfor %}
  </ul>
</section>

{% stylesheet %}
  .g-benefits { padding-block: var(--g-benefits-space); }
  .g-benefits__heading { margin: 0 0 22px; color: var(--g-primary); font-size: clamp(24px, 2.5vw, 32px); font-weight: 400; }
  .g-benefits__list { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0; margin: 0; padding: 0; list-style: none; border-block: 1px solid rgba(53, 76, 59, .16); }
  .g-benefits__item { min-width: 0; padding: 20px 22px; }
  .g-benefits__item + .g-benefits__item { border-left: 1px solid rgba(53, 76, 59, .16); }
  .g-benefits__item h3 { margin: 0 0 7px; color: var(--g-primary); font-size: 18px; line-height: 1.3; font-weight: 500; }
  .g-benefits__item p { margin: 0; color: var(--g-text); font-size: 14px; line-height: 1.55; }
  @media (max-width: 749px) {
    .g-benefits__list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .g-benefits__item { padding: 17px 14px; }
    .g-benefits__item:nth-child(3) { border-left: 0; }
    .g-benefits__item:nth-child(n + 3) { border-top: 1px solid rgba(53, 76, 59, .16); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "gravuru | Vorteile",
  "tag": "div",
  "class": "g-benefits-section",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Mit Sorgfalt für dich gestaltet" },
    { "type": "text", "id": "accessibility_label", "label": "Bereichsname für Screenreader", "default": "Vorteile" },
    { "type": "range", "id": "spacing", "label": "Abstand oben und unten", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 24 }
  ],
  "blocks": [
    { "type": "benefit", "name": "Vorteil", "settings": [
      { "type": "text", "id": "title", "label": "Titel", "default": "Persönlich" },
      { "type": "text", "id": "text", "label": "Kurztext", "default": "Deine Idee macht jedes Stück zu etwas Eigenem." }
    ] }
  ],
  "presets": [
    { "name": "gravuru | Vorteile", "blocks": [
      { "type": "benefit", "settings": { "title": "Persönlich", "text": "Deine Idee macht jedes Stück zu etwas Eigenem." } },
      { "type": "benefit", "settings": { "title": "Mit Bedacht gewählt", "text": "Produktdetails helfen dir, passend auszuwählen." } },
      { "type": "benefit", "settings": { "title": "Für besondere Momente", "text": "Ein persönliches Detail bleibt in Erinnerung." } }
    ] }
  ]
}
{% endschema %}
