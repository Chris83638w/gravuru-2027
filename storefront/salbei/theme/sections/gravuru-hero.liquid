<section class="g-hero g-shell" aria-labelledby="g-hero-title-{{ section.id }}" style="--g-hero-space: {{ section.settings.spacing }}px;">
  <div class="g-hero__copy">
    {% if section.settings.eyebrow != blank %}<p class="g-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
    <h1 id="g-hero-title-{{ section.id }}">{{ section.settings.heading | escape | newline_to_br }}</h1>
    {% if section.settings.text != blank %}<div class="g-hero__text rte">{{ section.settings.text }}</div>{% endif %}
    {% if section.settings.button_label != blank %}
      <a class="g-button" href="{% render 'gravuru-local-url', target: section.settings.button_link %}">{{ section.settings.button_label | escape }}<span class="g-icon" aria-hidden="true">{{ 'icon-arrow.svg' | inline_asset_content }}</span></a>
    {% endif %}
  </div>
  <div class="g-hero__media">
    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 2200 | image_tag: widths: '480, 750, 1000, 1440, 1800, 2200', sizes: '(min-width: 990px) 56vw, 100vw', loading: 'eager', fetchpriority: 'high', class: 'g-hero__image' }}
    {% else %}
      <img class="g-hero__image" src="{{ 'gravuru-hero.png' | asset_url }}" alt="{{ 'gravuru.images.hero' | t | escape }}" width="1448" height="1086" fetchpriority="high" loading="eager">
    {% endif %}
  </div>
</section>
{% schema %}
{
  "name": "gravuru · Titelbild",
  "tag": "div",
  "class": "g-hero-section",
  "enabled_on": { "templates": ["index"] },
  "settings": [
    {"type":"paragraph","content":"Texte, Bild und Ziel selbst bearbeiten. Das mitgelieferte Motiv ist eine gestaltete Bildillustration; für den Live-Shop durch ein freigegebenes Produktfoto ersetzen."},
    {"type":"text","id":"eyebrow","label":"Kleine Überschrift","default":"PERSÖNLICH. VON GRAVURU."},
    {"type":"textarea","id":"heading","label":"Hauptüberschrift","default":"Aus deinen Ideen.\nFür dein Leben."},
    {"type":"richtext","id":"text","label":"Beschreibung","default":"<p>Persönliche Schilder, Geschenke und Erinnerungen aus unserer Fertigung.</p>"},
    {"type":"image_picker","id":"image","label":"Titelbild"},
    {"type":"text","id":"button_label","label":"Buttontext","default":"Produkte entdecken"},
    {"type":"url","id":"button_link","label":"Buttonziel"},
    {"type":"range","id":"spacing","label":"Innenabstand","min":24,"max":80,"step":4,"unit":"px","default":56}
  ],
  "presets":[{"name":"gravuru · Titelbild"}]
}
{% endschema %}
