{% doc %}
  Displays the saved personalization image and its edit link in the cart image column.
  @param {line_item} item - Cart line to display.
  @param {string} [subpath] - Configurator app proxy subpath.
{% enddoc %}
{%- liquid
  assign gv_config = item.properties['_gravuru_config']
  assign gv_rev = item.properties['_gravuru_rev']
  assign gv_subpath = subpath | default: 'konfigurator'
  assign gv_legacy = false
  assign gv_native = false
  if gv_config != blank and gv_rev != blank
    assign gv_native = true
  elsif item.properties['_Gravuru Vorgang'] != blank and item.properties['Bearbeitbarer Entwurf'] != blank
    assign gv_legacy = true
  endif
  assign gv_preview = item.properties['_Entwurf']
  if gv_legacy
    assign gv_preview = item.properties['Entwurf']
  endif
  assign gv_saved = item.properties['_gravuru_bild']
  assign gv_saved_root = 'https://app-2027.gravuru-designwerkstatt.de/gestaltung/'
  assign gv_saved_prefix = gv_saved | slice: 0, gv_saved_root.size
  assign gv_saved_ext = gv_saved | slice: -4, 4
  assign gv_saved_valid = false
  if gv_native and gv_saved_prefix == gv_saved_root and gv_saved_ext == '.png'
    assign gv_preview = gv_saved
    assign gv_saved_valid = true
  endif
  assign gv_preview_prefix = gv_preview | slice: 0, 24
  assign gv_relative_prefix = gv_preview | slice: 0, 9
  assign gv_line = item.key
  if gv_preview != blank
    assign gv_line = 'theme'
  endif
  assign gv_edit_link = item.properties['_gravuru_bearbeiten'] | replace: '&amp;', '&' | split: '#' | first
  assign gv_edit_parts = gv_edit_link | split: '?'
  assign gv_ui_count = 0
  assign gv_ui_prio = false
  if gv_edit_parts.size == 2
    assign gv_edit_params = gv_edit_parts | last | split: '&'
    for gv_edit_param in gv_edit_params
      assign gv_edit_key = gv_edit_param | split: '=' | first
      if gv_edit_key == 'ui'
        assign gv_ui_count = gv_ui_count | plus: 1
        if gv_edit_param == 'ui=prio-r15'
          assign gv_ui_prio = true
        endif
      endif
    endfor
  endif
-%}
{%- if gv_native or gv_legacy -%}
  <div class="gravuru-cart-personalization">
    {%- if gv_saved_valid or gv_preview_prefix == 'https://cdn.shopify.com/' or gv_relative_prefix == '/uploads/' -%}
      <a class="gravuru-cart-preview-link" data-gravuru-preview data-close-label="{{ 'accessibility.close' | t | escape }}" href="{{ gv_preview | escape }}" target="_blank" rel="noopener">
        <img class="gravuru-cart-preview" src="{{ gv_preview | escape }}" alt="{{ item.product.title | escape }}"
             width="160" height="120" loading="lazy">
      </a>
    {%- elsif item.image -%}
      <a class="gravuru-cart-preview-link" href="{{ item.url }}" tabindex="-1" aria-label="{{ item.title | escape }}">
        {{- item.image | image_url: width: 360 | image_tag: loading: 'lazy', widths: '180,360', class: 'gravuru-cart-preview' -}}
      </a>
    {%- endif -%}
    {%- if gv_legacy -%}
    <a class="gravuru-cart-edit" rel="nofollow"
       aria-label="{{ 'general.cart.edit' | t | escape }}: {{ item.product.title | escape }}"
       href="{{ item.product.url }}?variant={{ item.variant.id }}&amp;gravuru_cart={{ item.key | url_encode }}">{{ 'general.cart.edit' | t }}</a>
    {%- else -%}
    <a class="gravuru-cart-edit" rel="nofollow"
       aria-label="{{ 'general.cart.edit' | t | escape }}: {{ item.product.title | escape }}"
       href="/apps/{{ gv_subpath | escape }}/start?product={{ item.product.id }}&amp;variant={{ item.variant.id }}&amp;config={{ gv_config | url_encode }}&amp;rev={{ gv_rev | url_encode }}&amp;line={{ gv_line | url_encode }}&amp;back={{ item.product.url | split: '?' | first | url_encode }}{% if gv_ui_count == 1 and gv_ui_prio %}&amp;ui=prio-r15{% endif %}">{{ 'general.cart.edit' | t }}</a>
    {%- endif -%}
  </div>
  <script type="module" src="{{ 'gravuru-legacy-cart.js' | asset_url }}"></script>
{%- endif -%}
{% stylesheet %}
  .gravuru-cart-image-dialog { padding: 16px; width: min(1000px, 96vw); max-height: 94dvh; border: 0; border-radius: 10px; }
  .gravuru-cart-image-dialog img { display: block; width: 100%; height: auto; max-height: 80dvh; object-fit: contain; }
  .gravuru-cart-image-dialog button, .gravuru-cart-editor-dialog > button { min-height: 44px; padding: 8px 16px; font: inherit; cursor: pointer; }
  .gravuru-cart-editor-dialog { width: 100vw; max-width: 100vw; height: 100dvh; max-height: 100dvh; padding: 0; margin: 0; border: 0; }
  .gravuru-cart-editor-dialog[open] { display: flex; flex-direction: column; }
  .gravuru-cart-editor-dialog > p { padding: 8px 16px; margin: 0; }
  .gravuru-cart-editor-dialog iframe { flex: 1; width: 100%; border: 0; min-height: 0; }
  .gravuru-cart-editor-dialog iframe[hidden] { display: none; }
  .gravuru-cart-image-dialog::backdrop, .gravuru-cart-editor-dialog::backdrop { background: #0008; }
  .gravuru-cart-personalization {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    width: 100%;
    gap: 4px;
  }
  .gravuru-cart-preview-link {
    display: block;
    width: 100%;
  }
  .gravuru-cart-preview {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
  }
  .gravuru-cart-edit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 4px 0;
    font-size: 14px;
    line-height: 1.4;
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .cart-item:has(.gravuru-cart-personalization) .cart-item__product--info,
  .cart-item:has(.gravuru-cart-personalization) .cart-item__details {
    min-width: 0;
    flex-basis: 0;
  }
  .cart-item:has(.gravuru-cart-personalization) .cart-item__title {
    overflow-wrap: anywhere;
  }
  .cart-item:has(.gravuru-cart-personalization) .cart-item__options > div {
    flex-wrap: wrap;
  }
  .cart-item:has(.gravuru-cart-personalization) .cart-item__options dd {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  @media (max-width: 767px) {
    table:has(.gravuru-cart-personalization) {
      table-layout: fixed;
    }
    .cart-item:has(.gravuru-cart-personalization) .grid {
      min-width: 0;
    }
  }
{% endstylesheet %}
