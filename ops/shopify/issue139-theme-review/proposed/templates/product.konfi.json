            "custom_liquid": "<div class=\"product__block product__block--price\">\n  <h3 class=\"h4\" style=\"margin:0 0 0.4rem 0\">Preis wie konfiguriert</h3>\n  <div role=\"status\" style=\"display:flex;align-items:baseline;flex-wrap:wrap;gap:0.5rem\">\n    {%- render 'price', product: product, use_variant: true, show_sale_badge: false, price_class: 'f-price--large' -%}\n    <div class=\"product__tax text-sm text-subtext rte\" style=\"margin:0\">\n      {%- if cart.taxes_included -%}{{ 'products.product.include_taxes' | t }}{%- endif -%}\n      {%- if shop.shipping_policy.body != blank -%} {{ 'products.product.shipping_policy_html' | t: link: shop.shipping_policy.url }}{%- endif -%}\n    </div>\n  </div>\n</div>"
          }
